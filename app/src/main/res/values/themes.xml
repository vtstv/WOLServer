<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Fire TV theme based on AppCompat for broader compatibility -->
    <style name="Theme.Leanback" parent="Theme.AppCompat.DayNight">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorPrimary">#007acc</item>
        <item name="colorPrimaryDark">#005a9e</item>
        <item name="colorAccent">#ffc107</item>
        <item name="android:textColorPrimary">#ffffff</item>
        <item name="android:textColorSecondary">#cccccc</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="alertDialogTheme">@style/FireTVAlertDialogTheme</item>
    </style>
    
    <style name="Theme.Leanback.Browse" parent="Theme.Leanback" />
    
    <!-- AlertDialog theme for Fire TV with proper contrast -->
    <style name="FireTVAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">#2d2d2d</item>
        <item name="android:textColorPrimary">#ffffff</item>
        <item name="android:textColorSecondary">#cccccc</item>
        <item name="colorAccent">#ffc107</item>
        <item name="buttonBarPositiveButtonStyle">@style/FireTVDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/FireTVDialogButton</item>
    </style>
    
    <style name="FireTVDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#ffc107</item>
    </style>
</resources>