<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Fire TV theme based on AppCompat for TV compatibility -->
    <style name="Theme.Leanback" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#0A0E17</item>
        <item name="colorPrimary">#00E5FF</item>
        <item name="colorPrimaryDark">#0097A7</item>
        <item name="colorAccent">#FF9900</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#94A3B8</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="alertDialogTheme">@style/FireTVAlertDialogTheme</item>
    </style>
    
    <style name="Theme.Leanback.Browse" parent="Theme.Leanback" />
    
    <!-- Custom TV Dialog Theme -->
    <style name="FireTVAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">#151B2B</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#94A3B8</item>
        <item name="colorAccent">#00E5FF</item>
        <item name="buttonBarPositiveButtonStyle">@style/FireTVDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/FireTVDialogButtonSecondary</item>
    </style>
    
    <style name="FireTVDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#00E5FF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FireTVDialogButtonSecondary" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#94A3B8</item>
    </style>
</resources>