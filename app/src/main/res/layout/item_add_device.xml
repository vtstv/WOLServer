<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardAddDevice"
    android:layout_width="200dp"
    android:layout_height="220dp"
    android:orientation="vertical"
    android:gravity="center"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/bg_tv_card_add_selector"
    android:padding="16dp"
    android:layout_margin="8dp">

    <TextView
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:text="➕"
        android:textSize="28sp"
        android:gravity="center"
        android:background="@drawable/bg_btn_secondary_selector"
        android:focusable="false"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_device_card_title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_device_card_sub"
        android:textSize="12sp"
        android:textColor="#94A3B8"
        android:layout_marginTop="4dp" />

</LinearLayout>
