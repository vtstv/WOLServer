<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E17"
    android:paddingStart="36dp"
    android:paddingEnd="36dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <!-- App Brand with Real Concept 3 App Icon -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/wol_firetv"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textSize="12sp"
                    android:textColor="#00E5FF" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Top Action Buttons -->
        <Button
            android:id="@+id/btnHeaderWakeAll"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/btn_wake_all"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_wake_selector"
            android:focusable="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnHeaderScan"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/btn_scan"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_secondary_selector"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnHeaderSettings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/btn_settings"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_secondary_selector"
            android:focusable="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />

    </LinearLayout>

    <!-- Main Content Area (2-Column Landscape Split) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Column: Devices List (65% width) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="65"
            android:orientation="vertical"
            android:layout_marginEnd="18dp">

            <!-- Devices Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/textDevicesHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target Devices (0)"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_dpad_browse"
                    android:textSize="12sp"
                    android:textColor="#64748B" />
            </LinearLayout>

            <!-- Devices RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDevices"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:focusable="true"
                android:descendantFocusability="afterDescendants" />

            <!-- Remote Navigation Hint -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hint_footer_remote"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Right Column: Server Status & Control (35% width) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="35"
            android:orientation="vertical"
            android:background="@drawable/bg_server_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/daemon_status_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <!-- Service Status Pill -->
            <TextView
                android:id="@+id/textServiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/service_running"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#00E676"
                android:background="@drawable/bg_status_badge"
                android:layout_marginBottom="14dp" />

            <!-- Server IP Address Box -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/web_endpoint_label"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/textServerAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="http://192.168.0.51:8085"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#00E5FF"
                android:typeface="monospace"
                android:background="@drawable/bg_edit_text_selector"
                android:padding="10dp"
                android:layout_marginBottom="16dp" />

            <!-- Service Control Button -->
            <Button
                android:id="@+id/btnToggleService"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="@string/btn_stop_service"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_primary_selector"
                android:focusable="true"
                android:layout_marginBottom="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Helper Box -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/footer_instructions"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:lineSpacingMultiplier="1.2" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>