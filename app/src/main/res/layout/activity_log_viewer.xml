<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingEnd="36dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:background="#0A0E17">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/btn_back"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_secondary_selector"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="16dp"
            android:nextFocusRight="@+id/buttonRefresh"
            android:nextFocusDown="@+id/scrollView" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/logs_activity_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/buttonRefresh"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/btn_refresh"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_secondary_selector"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="10dp"
            android:nextFocusLeft="@+id/buttonBack"
            android:nextFocusRight="@+id/buttonClear"
            android:nextFocusDown="@+id/scrollView" />

        <Button
            android:id="@+id/buttonClear"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/btn_clear"
            android:textColor="#FF5252"
            android:background="@drawable/bg_btn_secondary_selector"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nextFocusLeft="@+id/buttonRefresh"
            android:nextFocusRight="@+id/buttonClear"
            android:nextFocusDown="@+id/scrollView" />

    </LinearLayout>

    <!-- Log Display Box -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_server_card"
        android:padding="16dp"
        android:focusable="true"
        android:nextFocusUp="@+id/buttonRefresh">

        <TextView
            android:id="@+id/textLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading system logs..."
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:typeface="monospace"
            android:lineSpacingExtra="3dp"
            android:focusable="false"
            android:clickable="false"
            android:textIsSelectable="false" />

    </ScrollView>

    <!-- Instructions / Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/logs_debug_tip"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:layout_marginTop="10dp" />

</LinearLayout>